/**
 * Create Seller Refund (FRD 10.1), laid out like Magento's admin order pages.
 *
 * Everything shown on load comes from data the block has already read; the widget asks the server
 * to recalculate on each quantity change (one request per change) and the server re-validates on
 * submit (BR-03).
 */
/** @var \Acme\SellerRefund\Block\Adminhtml\Refund\Form $block */
/** @var \Magento\Framework\Escaper $escaper */
$lines = $block->getSellerLines();
$config = $block->getJsConfig();
$summary = $block->getOrderSummary();
$figures = $block->getInitialFigures();
$configJson = json_encode($config, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
$hasRefundable = false;
foreach ($lines as $line) {
    if (bccomp((string) $line['qty_remaining'], '0', 4) > 0) {
        $hasRefundable = true;
        break;
    }
}
